-- ========== 预设音乐播放（弹窗选择，可拖动，尺寸更小） ==========
UtilityTab:AddSection({ Name = "预设音乐播放" })

-- 动态显示当前选中（默认第一个）
local selectedLabel = UtilityTab:AddLabel("当前选中：" .. PresetMusicList[1].name)

-- 点击此按钮弹出选择列表
UtilityTab:AddButton({
    Name = "📋 选择预设音乐（点击弹窗）",
    Callback = function()
        local selectGui = Instance.new("ScreenGui")
        selectGui.Name = "PresetSelector"
        selectGui.Parent = LocalPlayer.PlayerGui

        -- 主面板：尺寸调小（宽260，高300）
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(0, 260, 0, 300)
        bg.Position = UDim2.new(0.5, -130, 0.5, -150)
        bg.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        bg.BorderSizePixel = 0
        bg.Parent = selectGui
        Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)

        -- 标题栏（可拖动）
        local titleBar = Instance.new("Frame")
        titleBar.Size = UDim2.new(1, 0, 0, 35)
        titleBar.BackgroundTransparency = 1
        titleBar.Parent = bg

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 1, 0)
        title.BackgroundTransparency = 1
        title.Text = "🎵 选择预设"
        title.TextColor3 = Color3.new(1,1,1)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 16
        title.Parent = titleBar

        -- 拖动逻辑（类似主窗口）
        local dragStart, dragPos
        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragStart = input.Position
                dragPos = bg.Position
            end
        end)
        titleBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
                local delta = input.Position - dragStart
                bg.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X,
                                        dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
            end
        end)
        titleBar.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragStart = nil
            end
        end)

        -- 滚动列表（填满除标题栏和底部按钮以外的区域）
        local listFrame = Instance.new("ScrollingFrame")
        listFrame.Size = UDim2.new(1, -16, 1, -75)   -- 上下留出空间
        listFrame.Position = UDim2.new(0, 8, 0, 40)
        listFrame.BackgroundTransparency = 1
        listFrame.ScrollBarThickness = 4
        listFrame.Parent = bg

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 4)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = listFrame

        -- 添加选项按钮
        for i, preset in ipairs(PresetMusicList) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            btn.Text = preset.name
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Font = Enum.Font.GothamSemibold
            btn.TextSize = 13
            btn.Parent = listFrame
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

            btn.MouseButton1Click:Connect(function()
                selectedPresetIndex = i
                selectedLabel:Set("当前选中：" .. preset.name)
                OrionLib:MakeNotification({Name="已选择", Content=preset.name, Time=1.5})
                selectGui:Destroy()
            end)
        end

        -- 自动调整画布大小
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            listFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end)

        -- 关闭按钮（放在底部）
        local closeBtn = Instance.new("TextButton")
        closeBtn.Size = UDim2.new(0, 60, 0, 28)
        closeBtn.Position = UDim2.new(1, -70, 1, -38)
        closeBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        closeBtn.Text = "关闭"
        closeBtn.TextColor3 = Color3.new(1,1,1)
        closeBtn.Font = Enum.Font.GothamBold
        closeBtn.TextSize = 13
        closeBtn.Parent = bg
        Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 5)
        closeBtn.MouseButton1Click:Connect(function()
            selectGui:Destroy()
        end)
    end
})

UtilityTab:AddButton({
    Name = "▶ 播放选中音乐（循环）",
    Callback = function()
        local preset = PresetMusicList[selectedPresetIndex]
        if not preset then
            OrionLib:MakeNotification({Name="错误", Content="未选择有效预设", Time=2})
            return
        end

        local success, err = pcall(function()
            writefile(preset.filename, game:HttpGet(preset.url))
        end)
        if not success then
            OrionLib:MakeNotification({Name="下载失败", Content=tostring(err), Time=3})
            return
        end

        initPresetSound()
        if not PresetSound then
            OrionLib:MakeNotification({Name="错误", Content="预设音频组件未初始化", Time=2})
            return
        end

        PresetSound:Stop()
        PresetSound.SoundId = getcustomasset(preset.filename)
        PresetSound.Volume = CurrentVolume
        PresetSound.Looped = true
        PresetSound:Play()

        OrionLib:MakeNotification({Name="播放中", Content=preset.name, Time=2})
    end
})

UtilityTab:AddButton({
    Name = "⏹ 停止预设音乐",
    Callback = function()
        if PresetSound then
            PresetSound:Stop()
            OrionLib:MakeNotification({Name="已停止", Content="预设音乐已停止", Time=1.5})
        else
            OrionLib:MakeNotification({Name="提示", Content="没有正在播放的预设音乐", Time=1.5})
        end
    end
})

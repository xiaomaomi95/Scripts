            audioInputGui:Destroy()
            audioInputGui = nil
            realTextBox = nil
        end

        realTextBox.FocusLost:Connect(finishInput)
        realTextBox.ReturnPressedFromOnScreenKeyboard:Connect(finishInput)
    end
})


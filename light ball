ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 90)
MainFrame.Position = UDim2.new(0.02, 0, 0.52, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
MainFrame.BorderSizePixel = 1
MainFrame.BorderColor3 = Color3.fromRGB(70, 70, 70)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 24, 0, 24)
CloseBtn.Position = UDim2.new(1, -26, 0, 2)
CloseBtn.BackgroundColor3 = Color3.fromRGB(160, 30, 30)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.new(1, 1, 1)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -30, 0, 30)
Title.Position = UDim2.new(0, 4, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "⚪ 白色声呐"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.Gotham
Title.TextSize = 14
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = MainFrame

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 130, 0, 36)
ToggleBtn.Position = UDim2.new(0.5, -65, 0, 45)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(70, 175, 70)
ToggleBtn.Text = "发射声呐"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.Gotham
ToggleBtn.TextSize = 14
ToggleBtn.Parent = MainFrame

ToggleBtn.MouseButton1Click:Connect(FireSonarPulse)

CloseBtn.MouseButton1Click:Connect(function()
    if restoreTask then
        task.cancel(restoreTask)
        restoreTask = nil
    end
    ClearAllHighlights()
    RestoreLighting()
    ScreenGui:Destroy()
end)

-- ===== 键盘快捷键 =====
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == PULSE_KEY then
        FireSonarPulse()
    end
end)

-- ===== 角色重生重置 =====
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    ClearAllHighlights()
    if restoreTask then
        task.cancel(restoreTask)
        restoreTask = nil
    end
    RestoreLighting()
end)

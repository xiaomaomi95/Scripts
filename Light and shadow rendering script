-- 黑白滤镜状态与特效实例缓存
local monochromeEffectActive = false
local originalColorCorrection = nil
local currentColorCorrection = nil

-- 单色黑白滤镜渲染
local function applyMonochromeShader()
    if currentColorCorrection then
        currentColorCorrection:Destroy()
    end
    
    currentColorCorrection = Instance.new("ColorCorrectionEffect")
    currentColorCorrection.Name = "MonochromeEffect"
    currentColorCorrection.Parent = Lighting
    
    currentColorCorrection.Brightness = 0.05  
    currentColorCorrection.Contrast = 0.1     
    currentColorCorrection.Saturation = -1    
    currentColorCorrection.TintColor = Color3.fromRGB(255, 255, 255)  
    
    -- 灰度环境光
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)  
    Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
    Lighting.ColorShift_Top = Color3.fromRGB(128, 128, 128)
    Lighting.ColorShift_Bottom = Color3.fromRGB(128, 128, 128)
    
    -- 基础亮度与雾效
    Lighting.Brightness = 0.8
    Lighting.FogColor = Color3.fromRGB(100, 100, 100)      
    monochromeEffectActive = true
    statusLabel.Text = "✅ 黑白滤镜已启用"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)  
end

-- 还原全部原始光照设置
local function resetLighting()
    for property, value in pairs(originalLighting) do
        Lighting[property] = value
    end
    
    if currentColorCorrection then
        currentColorCorrection:Destroy()
        currentColorCorrection = nil
    end
    
    monochromeEffectActive = false
    statusLabel.Text = "光照已恢复默认"
    statusLabel.TextColor3 = Color3.fromRGB(180, 180, 220)
end


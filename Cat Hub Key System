-- ============================================================
-- 2. 远程加载卡密列表（GitHub）
-- ============================================================
local function loadRemoteKeys()
    if not CONFIG.REMOTE_KEYS_URL or CONFIG.REMOTE_KEYS_URL == "" then
        warn("[猫咪Hub] 未配置远程卡密URL")
        return false
    end
    
    local success, response = pcall(function()
        return game:HttpGet(CONFIG.REMOTE_KEYS_URL)
    end)
    
    if not success or not response or response == "" then
        warn("[猫咪Hub] 远程卡密获取失败")
        return false
    end
    
    local count = 0
    -- 按行分割，同时也支持空格分隔
    for line in string.gmatch(response, "[^\r\n]+") do
        -- 如果一行中有多个用空格分隔的卡密，也解析
        for key in string.gmatch(line, "%S+") do
            local trimmed = key:gsub("^%s+", ""):gsub("%s+$", "")
            if trimmed ~= "" then
                table.insert(validKeys, trimmed)
                count = count + 1
            end
        end
    end
    
    print("[猫咪Hub] 远程卡密加载成功，共 " .. count .. " 个")
    return count > 0
end

-- ============================================================
-- 3. 远程加载/保存绑定记录（jsonbin.io）
-- ============================================================
local function table_count(t)
    local count = 0
    for _ in pairs(t) do count = count + 1 end
    return count
end

local function loadBindings()
    local url = "https://api.jsonbin.io/v3/b/" .. CONFIG.JSONBIN_BIN_ID .. "/latest"
    
    local success, response = pcall(function()
        return game:HttpGet(url, false, {
            ["X-Master-Key"] = CONFIG.JSONBIN_API_KEY,
        })
    end)
    
    if not success or not response then
        warn("[猫咪Hub] 绑定记录获取失败")
        return false
    end
    
    local success, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    
    if not success or not data or not data.record then
        warn("[猫咪Hub] 绑定记录解析失败")
        return false
    end
    
    bindings = data.record.bindings or {}
    print("[猫咪Hub] 绑定记录加载成功，共 " .. table_count(bindings) .. " 条")
    return true
end

local function saveBindings()
    local url = "https://api.jsonbin.io/v3/b/" .. CONFIG.JSONBIN_BIN_ID
    local data = {
        bindings = bindings,
        lastUpdated = os.date("!%Y-%m-%dT%TZ")
    }
    
    local jsonData = HttpService:JSONEncode(data)
    
    local success, response = pcall(function()
        return game:HttpPost(url, jsonData, false, {
            ["Content-Type"] = "application/json",
            ["X-Master-Key"] = CONFIG.JSONBIN_API_KEY,
        })
    end)
    
    if not success then
        warn("[猫咪Hub] 绑定记录保存失败")
        return false
    end
    
    print("[猫咪Hub] 绑定记录保存成功")
    return true
end

-- ============================================================
-- 4. 验证函数（含绑定检查）
-- ============================================================
local function verifyKey(input)
    -- 先检查是否在有效卡密列表中
    local isValid = false
    for _, validKey in ipairs(validKeys) do
        if input == validKey then
            isValid = true
            break
        end
    end
    
    if not isValid then
        return false, "卡密无效"
    end
    
    -- 检查是否已被其他玩家绑定
    local boundPlayer = bindings[input]
    if boundPlayer then
        if boundPlayer == currentPlayerId then
            return true, "验证成功"
        else
            return false, "该卡密已被其他玩家使用"
        end
    end
    
    -- 未被绑定，绑定当前玩家
    bindings[input] = currentPlayerId
    local saved = saveBindings()
    if saved then
        return true, "绑定成功"
    else
        bindings[input] = nil
        return false, "绑定失败，请重试"
    end
end

-- ============================================================
-- 5. 加载主Hub
-- ============================================================
local function loadMainHub()
    if isLoading then return end
    isLoading = true
    
    local maxRetries = 3
    local retryDelay = 1.5
    
    for attempt = 1, maxRetries do
        local success, result = pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "⏳ 加载中",
                Text = "正在加载猫咪Hub... (" .. attempt .. "/" .. maxRetries .. ")",
                Duration = 2
            })
            
            local scriptContent = game:HttpGet(CONFIG.HUB_URL)
            if scriptContent and scriptContent ~= "" then
                local func, err = loadstring(scriptContent)
                if func then
                    func()
                    return true
                else
                    error("脚本解析失败: " .. tostring(err))
                end
            else
                error("获取到的内容为空")
            end
        end)
        
        if success and result == true then
            if _G.AuthScreenGui then
                _G.AuthScreenGui:Destroy()
                _G.AuthScreenGui = nil
            end
            StarterGui:SetCore("SendNotification", {
                Title = "✅ 加载成功",
                Text = "猫咪Hub V6 已启动！",
                Duration = 2
            })
            isLoading = false
            return
        else
            local errMsg = tostring(result)
            print("[猫咪Hub] 加载失败 (尝试 " .. attempt .. "): " .. errMsg)
            
            if attempt < maxRetries then
                StarterGui:SetCore("SendNotification", {
                    Title = "⚠️ 重试中",
                    Text = "加载失败，正在重试... (" .. attempt .. "/" .. maxRetries .. ")",
                    Duration = 2
                })
                task.wait(retryDelay)
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "❌ 加载失败",
                    Text = "请检查网络连接后重新运行脚本",
                    Duration = 5
                })
                warn("[猫咪Hub] 最终加载失败，错误信息: " .. errMsg)
                isLoading = false
            end
        end
    end
end


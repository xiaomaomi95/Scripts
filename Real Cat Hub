-- ============================================
function OrionLib:RefreshTheme()
    if not self.ThemeObjects then return end
    local theme = self.Themes[self.SelectedTheme]
    if not theme then return end

    local propMap = {
        Main = "BackgroundColor3",
        Second = "BackgroundColor3",
        Stroke = "Color",
        Divider = "BackgroundColor3",
        Text = "TextColor3",
        TextDark = "TextColor3",
    }

    for objType, objList in pairs(self.ThemeObjects) do
        local prop = propMap[objType]
        if prop and theme[objType] then
            for _, obj in ipairs(objList) do
                if obj and obj.Parent then
                    pcall(function()
                        obj[prop] = theme[objType]
                    end)
                end
            end
        end
    end
end


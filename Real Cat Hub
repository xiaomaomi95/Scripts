local function CheckSpamKick(targetName)
    local isMatch = false
    for _,name in ipairs(spamConfig.TargetNames) do
        if name == targetName then
            isMatch = true
            break
        end
    end
    if not isMatch then return false end

    local now = os.clock()
    local cleanList = {}
    for _,t in ipairs(spamConfig.ClickTimes) do
        if now - t < spamConfig.Window then
            table.insert(cleanList,t)
        end
    end
    spamConfig.ClickTimes = cleanList
    table.insert(spamConfig.ClickTimes, now)

    if #spamConfig.ClickTimes >= spamConfig.MaxHit then
        game.Players.LocalPlayer:Kick("骚扰No")
        return true
    end
    return false
end

local function getOtherPlayerChar(playerObj, timeout)
	timeout = timeout or 3
	local startT = os.clock()
	while os.clock() - startT < timeout do
		local c = playerObj.Character
		if c and c.Parent and c:FindFirstChild("HumanoidRootPart") then
			return c
		end
		task.wait(0.05)
	end
	return nil
end

local function getLocalChar(timeout)

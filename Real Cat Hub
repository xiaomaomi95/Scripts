    Name = "防甩飞",
    Default = false,
    Callback = function(state)
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local CoreGui = game:GetService("CoreGui")
        local SoundService = game:GetService("Players").LocalPlayer
        local LocalPlayer = game:GetService("Players").LocalPlayer

        -- 全局缓存存储
        if not _G.AntiFlingData then
            _G.AntiFlingData = {
                playerCache = {},
                allConnections = {},
                addConn = nil,
                removeConn = nil,
                tipGui = nil,
                tipLabel = nil
            }
        end
        local Data = _G.AntiFlingData

        -- 音效函数
        local function playSound(sid)
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://"..sid
            s.Parent = SoundService
            s:Play()
            s.Ended:Connect(function() s:Destroy() end)
        end

        -- 缓存角色身体原始碰撞（跳过饰品Accessory）
        local function cacheParts(char)
            local cache = {}
            for _,obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") and not obj:FindFirstAncestorOfClass("Accessory") then
                    cache[obj] = obj.CanCollide
                end
            end
            return cache
        end

        -- 关闭碰撞防甩飞
        local function setNoColl(char, cache)
            for part in pairs(cache) do
                if part:IsDescendantOf(char) then
                    part.CanCollide = false
                end
            end
        end

        -- 恢复开启前原始碰撞
        local function restoreColl(char, cache)
            for part,origin in pairs(cache) do
                if part:IsDescendantOf(char) then
                    part.CanCollide = origin
                end
            end
        end

        -- 先销毁旧连接
        for _,c in pairs(Data.allConnections) do
            if c then c:Disconnect() end
        end
        table.clear(Data.allConnections)
        if Data.addConn then Data.addConn:Disconnect() Data.addConn = nil end
        if Data.removeConn then Data.removeConn:Disconnect() Data.removeConn = nil end

        if state then
            playSound("")
            OrionLib:MakeNotification({Name="防甩飞",Content="已开启，已关闭全部玩家碰撞",Time=2})
            table.clear(Data.playerCache)

            -- 底部提示文字
            if not Data.tipGui then
                Data.tipGui = Instance.new("ScreenGui")
                Data.tipGui.Name = "AntiFlingTip"
                Data.tipGui.ResetOnSpawn = false
                local parent = pcall(function() return CoreGui.RobloxGui end) and CoreGui or LocalPlayer.PlayerGui
                Data.tipGui.Parent = parent
                Data.tipLabel = Instance.new("TextLabel")
                Data.tipLabel.Size = UDim2.new(0,200,0,30)
                Data.tipLabel.Position = UDim2.new(0,15,1,-45)
                Data.tipLabel.BackgroundTransparency = 1
                Data.tipLabel.Font = Enum.Font.SourceSansBold
                Data.tipLabel.TextSize = 16
                Data.tipLabel.TextXAlignment = Enum.TextXAlignment.Left
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Color = Color3.new(0,0,0)
                stroke.Transparency = 0.3
                stroke.Parent = Data.tipLabel
                Data.tipLabel.Parent = Data.tipGui
            end
            Data.tipLabel.Text = ""
            Data.tipLabel.TextColor3 = Color3.fromRGB(0,255,140)

            -- 处理单个玩家
            local function handlePlayer(plr)
                if plr == LocalPlayer then return end
                local charConn = plr.CharacterAdded:Connect(function(newChar)
                    local c = cacheParts(newChar)
                    Data.playerCache[plr] = c
                    local loop = RunService.Stepped:Connect(function()
                        setNoColl(new,c)
                    end)
                    table.insert(Data.allConnections, loop)
                    newChar.Destroying:Connect(function() Data.playerCache[plr] = nil end)
                    setNoColl(newChar,c)
                end)
                table.insert(Data.allConnections, charConn)

                if plr.Character then
                    local c = cacheParts(plr.Character)
                    Data.playerCache[plr] = c
                    local loop = RunService.Stepped:Connect(function()
                        setNoColl(plr.Character,c)
                    end)
                    table.insert(Data.allConnections, loop)
                    setNoColl(plr.Character,c)
                end
            end

            -- 全局玩家监听
            Data.addConn = Players.PlayerAdded:Connect(handlePlayer)
            Data.removeConn = Players.PlayerRemoving:Connect(function(p)
                Data.playerCache[p] = nil
            end)

            -- 遍历在线玩家
            for _,p in ipairs(Players:GetPlayers()) do
                handlePlayer(p)
            end
        else
            playSound("12221967")
            OrionLib:MakeNotification({Name="防甩飞",Content="已关闭，正在恢复所有玩家原始碰撞",Time=2})

            if Data.tipLabel then
                Data.tipLabel.Text = ""
                Data.tipLabel.TextColor3 = Color3.new(1,0,0)
            end

            -- 立刻恢复全部缓存玩家的原始碰撞
            for plr,cache in pairs(Data.playerCache) do
                if plr.Character then
                    restoreColl(plr.Character, cache)
                end
            end

            table.clear(Data.playerCache)
            table.clear(Data.allConnections)
        end
    end
})

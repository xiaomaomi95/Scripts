    barCorner.Parent = bar
    bar.Parent = main

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,14,0,16)
    knob.BackgroundColor3 = Color3.fromRGB(120,180,255)
    local kCorner = Instance.new("UICorner")
    kCorner.CornerRadius = UDim.new(0,7)
    kCorner.Parent = knob
    knob.Parent = bar

    table.insert(sliderList, {lab=lab, bar=bar, knob=knob})
    knob.Position = UDim2.new(defaultValue,0,-0.5,0)

    local draggingSlider = false

    local function setKnobByX(screenX)
        local pos = math.clamp(screenX - bar.AbsolutePosition.X,0,bar.AbsoluteSize.X)
        knob.Position = UDim2.new(0,pos,-0.5,0)
        local val = pos / bar.AbsoluteSize.X
        updateFunc(val)
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            if i.UserInputType == Enum.UserInputType.Touch then
                i:Capture() --捕获触摸，阻止镜头旋转，仅滑块内部生效，不干扰标题栏
            end
            setKnobByX(i.Position.X)
        end
    end)

    bar.InputChanged:Connect(function(i)
        if draggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setKnobByX(i.Position.X)
        end
    end)

    bar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    return bar,knob,lab
end


local function destroyBoardLogic()
    print("销毁踏空板")
    if loopConn then loopConn:Disconnect() loopConn = nil end
    if board then board:Destroy() board = nil end
    boardY = nil
    jumpPeakY = nil
    isJumping = false
end

local function createBoard()
    local old = workspace:FindFirstChild("WalkBoard")
    if old then old:Destroy() end
    local b = Instance.new("Part")
    b.Name = "WalkBoard"
    b.Size = Vector3.new(2,0.2,2)
    b.Transparency = 1
    b.CanCollide = true
    b.CanTouch = false
    b.Anchored = true
    b.Massless = true
    b.Parent = workspace
    board = b
end

local function setupCharacter(char)
    print("角色加载，初始化踏空")
    destroyBoardLogic()
    createBoard()
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    boardY = root.Position.Y - 3.4
    jumpPeakY = nil
    isJumping = false

    hum.Jumping:Connect(function(state)
        if state and enabled then
            isJumping = true
            jumpPeakY = root.Position.Y
        end
    end)

    loopConn = RunService.Stepped:Connect(function()
        if not enabled then return end
        if not (root and root:IsDescendantOf(workspace) and board) then return end
        local plyY = root.Position.Y

        if isJumping then
            if plyY > jumpPeakY then
                jumpPeakY = plyY
            end
            if plyY < jumpPeakY -0.3 then
                isJumping = false
                boardY = jumpPeakY - 3.4
            end
        end
        board.Position = Vector3.new(root.Position.X, boardY, root.Position.Z)
    end)
end


        local val = pos / bar.AbsoluteSize.X
        updateFunc(val)
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            if i.UserInputType == Enum.UserInputType.Touch then
                i:Capture() --捕获触摸，阻止镜头旋转，仅滑块内部生效，不干扰标题栏
            end
            setKnobByX(i.Position.X)
        end
    end)

    bar.InputChanged:Connect(function(i)
        if draggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setKnobByX(i.Position.X)
        end
    end)

    bar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

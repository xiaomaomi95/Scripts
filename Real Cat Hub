UtilityTab:AddToggle({
    Name = "玩家高亮",
    Default = false,
    Callback = function(state)
        -- 全局存储
        if not rawget(_G, "PlayerESPStorage") then _G.PlayerESPStorage = {} end  -- { [player] = highlight }
        if not rawget(_G, "PlayerESPConnections") then _G.PlayerESPConnections = {} end

        local Players = game:GetService("Players")
        local lp = Players.LocalPlayer

        -- 辅助：根据队伍返回颜色
        local function getTeamColor(player)
            local team = player.Team
            if team then
                -- 判断是否同队
                if lp.Team and team == lp.Team then
                    return Color3.fromRGB(0, 255, 0)   -- 绿色
                else
                    return Color3.fromRGB(255, 50, 50) -- 红色
                end
            else
                -- 没有队伍则视为不同队（红色）
                return Color3.fromRGB(255, 50, 50)
            end
        end

        -- 为单个玩家创建/更新高亮
        local function updatePlayerHighlight(player)
            if player == lp then return end  -- 不给自己高亮
            local char = player.Character
            if not char then
                -- 如果没有角色，移除已有高亮
                local h = _G.PlayerESPStorage[player]
                if h then
                    pcall(function() h:Destroy() end)
                    _G.PlayerESPStorage[player] = nil
                end
                return
            end

            local highlight = _G.PlayerESPStorage[player]
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "PlayerESP_Highlight"
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.FillTransparency = 0.4
                highlight.OutlineTransparency = 0
                highlight.Parent = char
                _G.PlayerESPStorage[player] = highlight
            end

            -- 更新颜色
            local color = getTeamColor(player)
            highlight.FillColor = color
            highlight.OutlineColor = color
            -- 确保Adornee正确
            if highlight.Adornee ~= char then
                highlight.Adornee = char
            end
        end

        -- 清理单个玩家的高亮和监听
        local function cleanupPlayer(player)
            local h = _G.PlayerESPStorage[player]
            if h then
                pcall(function() h:Destroy() end)
                _G.PlayerESPStorage[player] = nil
            end
            -- 断开该玩家相关的连接（存于连接表中）
            local conns = _G.PlayerESPConnections[player]
            if conns then
                for _, conn in ipairs(conns) do
                    pcall(function() conn:Disconnect() end)
                end
                _G.PlayerESPConnections[player] = nil
            end
        end

        -- 为玩家设置所有监听
        local function setupPlayer(player)
            if player == lp then return end
            -- 避免重复设置
            if _G.PlayerESPConnections[player] then
                cleanupPlayer(player)
            end

            local conns = {}

            -- 角色出现时更新高亮
            local charAdded = player.CharacterAdded:Connect(function(char)
                -- 延迟一帧等Humanoid加载
                task.wait(0.1)
                updatePlayerHighlight(player)
            end)
            table.insert(conns, charAdded)

            -- 角色移除时清除高亮
            local charRemoving = player.CharacterRemoving:Connect(function()
                local h = _G.PlayerESPStorage[player]
                if h then
                    pcall(function() h:Destroy() end)
                    _G.PlayerESPStorage[player] = nil
                end
            end)
            table.insert(conns, charRemoving)

            -- 队伍变化时更新颜色
            if player.Team then
                local teamChanged = player:GetPropertyChangedSignal("Team"):Connect(function()
                    updatePlayerHighlight(player)
                end)
                table.insert(conns, teamChanged)
            end

            -- 如果玩家本身有TeamColor属性（兼容某些游戏）
            -- 但通常Team就够

            _G.PlayerESPConnections[player] = conns

            -- 立即为当前角色添加高亮（如果有）
            if player.Character then
                updatePlayerHighlight(player)
            end
        end

        --==== 关闭逻辑 ====
        if not state then
            -- 销毁所有高亮
            for player, h in pairs(_G.PlayerESPStorage) do
                pcall(function() h:Destroy() end)
            end
            table.clear(_G.PlayerESPStorage)

            -- 断开所有玩家连接
            for player, conns in pairs(_G.PlayerESPConnections) do
                for _, conn in ipairs(conns) do
                    pcall(function() conn:Disconnect() end)
                end
            end
            table.clear(_G.PlayerESPConnections)

            -- 断开全局连接（玩家加入/离开）
            if _G.PlayerESPGlobalConn then
                pcall(function() _G.PlayerESPGlobalConn:Disconnect() end)
                _G.PlayerESPGlobalConn = nil
            end
            if _G.PlayerESPGlobalConn2 then
                pcall(function() _G.PlayerESPGlobalConn2:Disconnect() end)
                _G.PlayerESPGlobalConn2 = nil
            end

            OrionLib:MakeNotification({Name="玩家高亮", Content="已关闭", Time=2})
            return
        end

        --==== 开启逻辑 ====
        -- 先清理旧状态（防叠加）
        if _G.PlayerESPGlobalConn then pcall(function() _G.PlayerESPGlobalConn:Disconnect() end) end
        if _G.PlayerESPGlobalConn2 then pcall(function() _G.PlayerESPGlobalConn2:Disconnect() end) end

        -- 为所有已存在的玩家设置监听（除自己）
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp then
                setupPlayer(player)
            end
        end

        -- 监听新玩家加入
        _G.PlayerESPGlobalConn = Players.PlayerAdded:Connect(function(player)
            if player ~= lp then
                setupPlayer(player)
            end
        end)

        -- 监听玩家离开，清理资源
        _G.PlayerESPGlobalConn2 = Players.PlayerRemoving:Connect(function(player)
            cleanupPlayer(player)
        end)

        OrionLib:MakeNotification({Name="玩家高亮", Content="已开启（同队绿/异队红）", Time=2})
    end
})
UtilityTab:AddToggle({
    Name = "NPC高亮",
    Default = false,
    Callback = function(state)
        -- 全局存储高亮对象和连接
        if not rawget(_G, "ESPRenderConn") then _G.ESPRenderConn = nil end
        if not rawget(_G, "ESPStorage") then _G.ESPStorage = {} end
        if not rawget(_G, "ESPEventConn") then _G.ESPEventConn = nil end

        -- 辅助函数：为单个NPC创建高亮
        local function addHighlight(model)
            if _G.ESPStorage[model] then return end  -- 已有高亮
            local highlight = Instance.new("Highlight")
            highlight.Name = "NPC_ESP_Highlight"
            highlight.Adornee = model
            highlight.FillTransparency = 0.45
            highlight.OutlineTransparency = 0
            highlight.FillColor = Color3.fromRGB(255, 50, 50)
            highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = model
            _G.ESPStorage[model] = highlight
        end

        -- 辅助函数：移除高亮
        local function removeHighlight(model)
            local h = _G.ESPStorage[model]
            if h then
                pcall(function() h:Destroy() end)
                _G.ESPStorage[model] = nil
            end
        end

        -- 判断是否为NPC（Model且含Humanoid，且不属于任何玩家）
        local function isNPC(model)
            if not model:IsA("Model") then return false end
            if not model:FindFirstChildOfClass("Humanoid") then return false end
            if game:GetService("Players"):GetPlayerFromCharacter(model) then return false end
            return true
        end

        -- 关闭逻辑
        if not state then
            -- 断开所有连接
            if _G.ESPRenderConn then
                pcall(function() _G.ESPRenderConn:Disconnect() end)
                _G.ESPRenderConn = nil
            end
            if _G.ESPEventConn then
                pcall(function() _G.ESPEventConn:Disconnect() end)
                _G.ESPEventConn = nil
            end
            -- 销毁所有高亮
            for model, highlightObj in pairs(_G.ESPStorage) do
                pcall(function() highlightObj:Destroy() end)
            end
            table.clear(_G.ESPStorage)
            OrionLib:MakeNotification({Name="NPC高亮", Content="已关闭", Time=2})
            return
        end

        --==== 开启逻辑 ====
        -- 先清理旧连接（防叠加）
        if _G.ESPRenderConn then pcall(function() _G.ESPRenderConn:Disconnect() end); _G.ESPRenderConn = nil end
        if _G.ESPEventConn then pcall(function() _G.ESPEventConn:Disconnect() end); _G.ESPEventConn = nil end

        local workspace = game:GetService("Workspace")
        local Players = game:GetService("Players")

        -- 1. 初始化：为当前场景中所有已存在的NPC添加高亮
        for _, model in ipairs(workspace:GetChildren()) do
            if isNPC(model) then
                addHighlight(model)
            end
        end

        -- 2. 监听新增模型（DescendantAdded 可能触发多次，但只关心顶级Model）
        local addedConn = workspace.DescendantAdded:Connect(function(desc)
            -- 只关心顶级Model（即直接父级为workspace的Model），减少误判
            if desc.Parent == workspace and isNPC(desc) then
                addHighlight(desc)
            end
        end)

        -- 3. 监听模型被移除
        local removedConn = workspace.DescendantRemoved:Connect(function(desc)
            if desc.Parent == workspace and isNPC(desc) then
                removeHighlight(desc)
            end
        end)

        -- 4. 额外处理：当NPC内部Humanoid被移除或添加时（极少发生），但为了稳健，也可以用Humanoid的AncestryChanged
        --    但这里简化，因为通常NPC不会动态改变Humanoid。

        -- 存储连接以便关闭
        _G.ESPEventConn = { addedConn, removedConn }  -- 用表存放多个连接

        -- 同时保留一个“心跳”用于清理已删除但未触发事件的高亮（保险），但改为较低频率（例如每10秒一次）或甚至省略
        -- 为极致性能，此处不做心跳，依赖 DescendantRemoved 事件。若担心事件遗漏，可用 RunService.Stepped 每5秒检查一次（但一般不需要）


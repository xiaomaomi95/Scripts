-- 随机生成新方块
function newPiece()
	local pieceIndex = math.random(1, #tetriminos)
	local pieceData = tetriminos[pieceIndex]
	currentPiece.shape = pieceData[1]
	currentPiece.color = pieceData.color
	currentPiece.x = math.floor(boardWidth/2) - math.floor(#currentPiece.shape[1]/2)
	currentPiece.y = 1
	currentPiece.rotation = 1
	if checkCollision(currentPiece.x, currentPiece.y, currentPiece.shape) then
		gameOver()
		return false
	end
	return true
end
-- 碰撞检测：检测方块是否出界/碰到已固定方块
function checkCollision(x, y, shape)
	for row = 1, #shape do
		for col = 1, #shape[row] do
			if shape[row][col] ~= 0 then
				local boardX = x + col - 1
				local boardY = y + row - 1
				if boardX < 1 or boardX > boardWidth or boardY > boardHeight then
					return true
				end
				if boardY > 0 and board[boardY][boardX] ~= 0 then
					return true
				end
			end
		end
	end
	return false
end
-- 方块落地，固定到棋盘【修复】
function lockPiece()
	for row = 1, #currentPiece.shape do
		for col = 1, #currentPiece.shape[row] do
			if currentPiece.shape[row][col] ~= 0 then
				local boardX = currentPiece.x + col - 1
				local boardY = currentPiece.y + row - 1
				if boardY > 0 then
					board[boardY][boardX] = 1
					boardCells[boardY][boardX].BackgroundColor3 = currentPiece.color
				end
			end
		end
	end
	checkLines()
	newPiece()
end
-- 扫描并消除填满的整行，计算得分
function checkLines()
	local linesToClear = {}
	for y = 1, boardHeight do
		local lineFull = true
		for x = 1, boardWidth do
			if board[y][x] == 0 then
				lineFull = false
				break
			end
		end
		if lineFull then
			table.insert(linesToClear, y)
		end
	end
	if #linesToClear > 0 then
		for _, y in ipairs(linesToClear) do
			for x = 1, boardWidth do
				board[y][x] = 0
			end
			for yy = y, 2, -1 do
				for x = 1, boardWidth do
					board[yy][x] = board[yy-1][x]
				end
			end
			for x = 1, boardWidth do
				board[1][x] = 0
			end
		end
		local baseScore = 0
		if #linesToClear == 1 then baseScore = 40
		elseif #linesToClear == 2 then baseScore = 100
		elseif #linesToClear == 3 then baseScore = 300
		elseif #linesToClear == 4 then baseScore = 1200 end
		score = score + baseScore * level
		linesCleared = linesCleared + #linesToClear
		level = math.floor(linesCleared / 10) + 1
		ScoreLabel.Text = "得分：" .. tostring(score)
		LevelLabel.Text = "等级：" .. tostring(level)
		LinesLabel.Text = "消除行数：" .. tostring(linesCleared)
		if gameRunning and not gamePaused then
			LineClearSound:Play()
		end
	end
end
-- 重绘整个棋盘格子【修复】
function drawBoard()
	for y = 1, boardHeight do
		for x = 1, boardWidth do
			if board[y][x] == 0 then
				boardCells[y][x].BackgroundColor3 = Color3.fromRGB(30,30,30)
			end
		end
	end
	if gameRunning and not gamePaused then
		for row = 1, #currentPiece.shape do
			for col = 1, #currentPiece.shape[row] do
				if currentPiece.shape[row][col] ~= 0 then
					local boardX = currentPiece.x + col - 1
					local boardY = currentPiece.y + row - 1
					if boardY > 0 and boardY <= boardHeight and boardX >=1 and boardX <= boardWidth then
						boardCells[boardY][boardX].BackgroundColor3 = currentPiece.color
					end
				end
			end
		end
	end
end
-- 方块移动函数 dx左右 dy上下
function movePiece(dx, dy)
	if not gameRunning or gamePaused then return end
	if not checkCollision(currentPiece.x + dx, currentPiece.y + dy, currentPiece.shape) then
		currentPiece.x += dx
		currentPiece.y += dy
		drawBoard()
		return true
	end
	if dy > 0 then
		lockPiece()
		drawBoard()
	end
	return false
end
-- 方块顺时针旋转
function rotatePiece()
	if not gameRunning or gamePaused then return end
	local currentShape = currentPiece.shape
	local newShape = {}
	for i = 1, #currentShape[1] do
		newShape[i] = {}
		for j = 1, #currentShape do
			newShape[i][j] = currentShape[#currentShape - j + 1][i]
		end
	end
	if not checkCollision(currentPiece.x, currentPiece.y, newShape) then
		currentPiece.shape = newShape
		drawBoard()
	end
end
-- 游戏结束处理
function gameOver()
	gameRunning = false
	StartPauseButton.Text = "开始游戏"
	StartPauseButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
	BGM:Stop()
	local message = Instance.new("TextLabel")
	message.Name = "GameOverMessage"
	message.Size = UDim2.new(1, 0, 0, 50)
	message.Position = UDim2.new(0, 0, 0.5, -25)
	message.BackgroundColor3 = Color3.new(0, 0, 0)
	message.BackgroundTransparency = 0.7
	message.Text = "游戏结束！\n得分：" .. tostring(score) .. "\n3秒后自动重启..."
	message.TextColor3 = Color3.new(1, 1, 1)
	message.TextSize = 14
	message.Font = Enum.Font.GothamBold
	message.ZIndex = 10
	message.Parent = BoardFrame
	task.wait(3)
	if BoardFrame:FindFirstChild("GameOverMessage") then
		BoardFrame.GameOverMessage:Destroy()
	end
	resetGame()
	gameRunning = true
	StartPauseButton.Text = "暂停"
	StartPauseButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
	if bgmEnabled then BGM:Play() end
end
-- 完整重置游戏数据
function resetGame()
	score = 0
	level = 1
	linesCleared = 0
	ScoreLabel.Text = "得分：0"
	LevelLabel.Text = "等级：1"
	LinesLabel.Text = "消除行数：0"
	if BoardFrame:FindFirstChild("GameOverMessage") then
		BoardFrame.GameOverMessage:Destroy()
	end
	initBoard()
	newPiece()
	drawBoard()
end
-- 游戏主循环：自动下落计时
local lastUpdate = tick()
local fallTime = 1.0
function gameLoop()
	if not gameRunning or gamePaused then return end
	local currentTime = tick()
	if currentTime - lastUpdate > fallTime / level then
		movePiece(0, 1)
		lastUpdate = currentTime
	end
end

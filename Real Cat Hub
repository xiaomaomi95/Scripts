-- 备份容器
if not _G.GraphicBackup then _G.GraphicBackup = {} end
if not _G.GraphicState then _G.GraphicState = {} end

-- 通用备份与恢复函数（保存原始父级）
local function backupAndHide(className, state)
    if state then
        if not _G.GraphicBackup[className] then
            _G.GraphicBackup[className] = {}
            for _, obj in ipairs(game:GetDescendants()) do
                if obj:IsA(className) then
                    table.insert(_G.GraphicBackup[className], {
                        obj = obj,
                        parent = obj.Parent,
                        position = obj:IsA("BasePart") and obj.Position or nil
                    })
                end
            end
        end
        -- 隐藏（移出父级）
        for _, entry in ipairs(_G.GraphicBackup[className]) do
            if entry.obj and entry.obj.Parent then
                entry.obj.Parent = nil
            end
        end
        _G.GraphicState[className] = true
    else
        -- 恢复
        if _G.GraphicBackup[className] then
            for _, entry in ipairs(_G.GraphicBackup[className]) do
                if entry.obj and not entry.obj.Parent then
                    entry.obj.Parent = entry.parent
                    if entry.position and entry.obj:IsA("BasePart") then
                        entry.obj.Position = entry.position
                    end
                end
            end
            _G.GraphicBackup[className] = nil
        end
        _G.GraphicState[className] = false
    end
end


            end)
            -- 销毁整个FOV ScreenGui
            if _G.FOVScreenGui then
                pcall(function() _G.FOVScreenGui:Destroy() end)
                _G.FOVScreenGui = nil
            end
            _G.FOVCircle = nil
            OrionLib:MakeNotification({Name="自瞄系统",Content="平滑自瞄已关闭",Time=2})
            return
        end

        --====开启逻辑====
        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")
        local UserInputService = game:GetService("UserInputService")
        local camera = workspace.CurrentCamera
        local player = Players.LocalPlayer

        local target = nil
        local MOUSE_LOCKED = false

        -- 创建FOV圆圈（修复居中问题）
        if not _G.FOVCircle then
            local screenGui = Instance.new("ScreenGui")
            screenGui.Name = "FOVGui"
            screenGui.ResetOnSpawn = false
            screenGui.Parent = player:WaitForChild("PlayerGui")
            
            -- 【修复1】让ScreenGui铺满整个屏幕
            screenGui.Enabled = true
            screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

            local fovCircle = Instance.new("Frame")
            fovCircle.Size = UDim2.new(0, _G.AimbotFOV*2, 0, _G.AimbotFOV*2)
            fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
            
            -- 【修复2】使用Offset方式确保绝对居中
            -- 使用0.5,0会相对于父级（ScreenGui）居中，但需要父级全屏
            fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
            
            fovCircle.BackgroundColor3 = Color3.fromRGB(255,0,0)
            fovCircle.BackgroundTransparency = 1
            fovCircle.BorderSizePixel = 0
            fovCircle.Parent = screenGui

            local circleCorner = Instance.new("UICorner")
            circleCorner.CornerRadius = UDim.new(1,0)
            circleCorner.Parent = fovCircle

            local circleStroke = Instance.new("UIStroke")
            circleStroke.Color = Color3.fromRGB(255, 0, 0)
            circleStroke.Thickness = 2
            circleStroke.Transparency = 0
            circleStroke.Parent = fovCircle

            _G.FOVCircle = fovCircle
            _G.FOVScreenGui = screenGui
        end
        _G.FOVCircle.Visible = true

        -- 更新圆圈大小函数
        local function updateFovCircle()
            if _G.FOVCircle then
                _G.FOVCircle.Size = UDim2.new(0, _G.AimbotFOV*2, 0, _G.AimbotFOV*2)
            end
        end
        updateFovCircle()

        -- 可见性检测
        local function isVisible(targetCharacter)
            if not targetCharacter then return false end
            
            local aimPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
            if not aimPart then return false end
            
            local origin = camera.CFrame.Position
            local direction = aimPart.Position - origin
            
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {
                player.Character,
                targetCharacter
            }
            
            local result = workspace:Raycast(origin, direction, params)
            return result == nil
        end

        -- 获取FOV内最近的玩家
        local function getClosestInFOV()
            local closest = nil
            local shortestDistance = math.huge
            local screenCenter = Vector2.new(
                camera.ViewportSize.X/2,
                camera.ViewportSize.Y/2
            )

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    
                    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                    local aimPart = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                    
                    if humanoid and humanoid.Health > 0 and aimPart then
                        
                        local screenPos, onScreen = camera:WorldToViewportPoint(aimPart.Position)
                        
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            
                            if dist < _G.AimbotFOV and dist < shortestDistance then
                                if isVisible(plr.Character) then
                                    closest = plr
                                    shortestDistance = dist
                                end
                            end
                        end
                    end
                end
            end
            
            return closest
        end

        -- 清理旧连接
        if _G.AimbotRenderConn then
            pcall(function() _G.AimbotRenderConn:Disconnect() end)
            _G.AimbotRenderConn = nil
        end

        -- 自瞄主循环
        local loopConn = RunService.RenderStepped:Connect(function()
            -- 每帧更新圆圈大小（确保FOV滑块调整后立即生效）
            updateFovCircle()

            target = getClosestInFOV()
            
            if target and target.Character then
                local aimPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
                
                if aimPart then
                    local camPos = camera.CFrame.Position
                    local lookAt = CFrame.new(camPos, aimPart.Position)
                    
                    camera.CFrame = camera.CFrame:Lerp(lookAt, _G.AimbotSmoothness)
                    
                    if not MOUSE_LOCKED then
                        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                        MOUSE_LOCKED = true
                    end
                end
            else
                if MOUSE_LOCKED then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                    MOUSE_LOCKED = false
                end
            end
        end)
        _G.AimbotRenderConn = loopConn

        OrionLib:MakeNotification({Name="自瞄系统",Content="平滑自瞄已开启",Time=2})
    end
})


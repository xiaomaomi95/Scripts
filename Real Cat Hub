    Default = false,
    Callback = function(state)
        if not rawget(_G, "AimbotRenderConn") then _G.AimbotRenderConn = nil end

        --====关闭逻辑====
        if not state then
            if _G.AimbotRenderConn then
                pcall(function() _G.AimbotRenderConn:Disconnect() end)
                _G.AimbotRenderConn = nil
            end
            -- 解锁鼠标

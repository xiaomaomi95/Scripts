local function setupCharacter(char)
    print("角色加载，初始化踏空")
    destroyBoardLogic()
    createBoard()
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    boardY = root.Position.Y - 3.4
    jumpPeakY = nil
    isJumping = false

    hum.Jumping:Connect(function(state)
        if state and enabled then
            isJumping = true
            jumpPeakY = root.Position.Y
        end
    end)

    loopConn = RunService.Stepped:Connect(function()
        if not enabled then return end
        if not (root and root:IsDescendantOf(workspace) and board) then return end
        local plyY = root.Position.Y

        if isJumping then
            if plyY > jumpPeakY then
                jumpPeakY = plyY
            end
            if plyY < jumpPeakY -0.3 then
                isJumping = false
                boardY = jumpPeakY - 3.4
            end
        end
        board.Position = Vector3.new(root.Position.X, boardY, root.Position.Z)
    end)
end


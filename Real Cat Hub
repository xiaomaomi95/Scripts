UtilityTab:AddToggle({
    Name = "穿墙",
    Default = false,
    Callback = function(state)
        local RunService = game:GetService("RunService")
        local LocalPlayer = game:GetService("Players").LocalPlayer

        -- 清理旧连接
        if _G.NoclipLoop then
            _G.NoclipLoop:Disconnect()
            _G.NoclipLoop = nil
        end
        if _G.NoclipCharConn then
            _G.NoclipCharConn:Disconnect()
            _G.NoclipCharConn = nil
        end

        -- 缓存角色身体原始碰撞（跳过饰品Accessory）
        local function CacheOrigin(character)
            if not character then return end
            _G.NoclipBodyCache = {}
            for _, obj in ipairs(character:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local accessory = obj:FindFirstAncestorOfClass("Accessory")
                    if not accessory then
                        _G.NoclipBodyCache[obj] = obj.CanCollide
                    end
                end
            end
        end

        -- 开启穿墙：身体全部无碰撞
        local function ApplyNoClip(character)
            if not character or not _G.NoclipBodyCache then return end
            for part in pairs(_G.NoclipBodyCache) do
                if part:IsDescendantOf(character) then
                    part.CanCollide = false
                end
            end
        end

        -- 关闭穿墙：还原缓存原始碰撞，不强制true
        local function RestoreCollision(character)
            if not character or not _G.NoclipBodyCache then return end
            for part, originalCollide in pairs(_G.NoclipBodyCache) do
                if part:IsDescendantOf(character) then
                    part.CanCollide = originalCollide
                end
            end
        end

        -- 重生自动重新缓存
        _G.NoclipCharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            task.wait(0.1)
            CacheOrigin(newChar)
            if state then
                ApplyNoClip(newChar)
            end
        end)

        -- 当前角色初始化缓存
        local currentChar = LocalPlayer.Character
        CacheOrigin(currentChar)

        if state then
            _G.NoclipLoop = RunService.Stepped:Connect(function()
                ApplyNoClip(LocalPlayer.Character)
            end)
            ApplyNoClip(currentChar)
            OrionLib:MakeNotification({Name="穿墙", Content="已开启穿墙模式", Time=2})
        else
            RestoreCollision(currentChar)
            OrionLib:MakeNotification({Name="穿墙", Content="已关闭穿墙模式", Time=2})
        end
    end
})
UtilityTab:AddToggle({
    Name = "移速修改",
    Default = false,
    Callback = function(state)
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")

        if state then
            _G.OriginalWalkSpeed = nil
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    _G.OriginalWalkSpeed = hum.WalkSpeed
                end
            end

            if _G.SpeedConn then _G.SpeedConn:Disconnect() end
            _G.SpeedConn = RunService.RenderStepped:Connect(function()
                local c = LocalPlayer.Character
                if not c then return end
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")
                if not (hum and root) then return end

                hum.WalkSpeed = _G.MoveSpeed or 50
                local moveDir = Vector3.new(0,0,0)
                local moveVec = hum.MoveDirection

                if moveVec.Magnitude > 0 then
                    moveDir = moveVec
                else
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += root.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= root.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= root.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += root.CFrame.RightVector end
                end

                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit
                    root.Velocity = Vector3.new(moveDir.X*(_G.MoveSpeed or 50), root.Velocity.Y, moveDir.Z*(_G.MoveSpeed or 50))
                else
                    root.Velocity = Vector3.new(0, root.Velocity.Y, 0)
                end
            end)

            OrionLib:MakeNotification({Name="移速修改",Content="移速增强开启",Time=2})
        else
            if _G.SpeedConn then
                _G.SpeedConn:Disconnect()
                _G.SpeedConn = nil
            end
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Velocity = Vector3.new(0, root.Velocity.Y, 0)
                end
                if hum and _G.OriginalWalkSpeed then
                    hum.WalkSpeed = _G.OriginalWalkSpeed
                end
            end
            OrionLib:MakeNotification({Name="移速修改",Content="移速增强关闭",Time=2})
        end
    end
})

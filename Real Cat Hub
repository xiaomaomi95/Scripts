		cTop.CFrame = cp.CFrame * CFrame.new(0, 2.15, 0)
		cTop.Color = Color3.fromRGB(25, 25, 45)
		cTop.Material = Enum.Material.Marble
		cTop.Anchored = true
		cTop.CanCollide = true
		cTop.Parent = interior

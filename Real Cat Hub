                local health = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local fill = state.main.HealthBar.Fill
                fill.Size = UDim2.fromScale(health, 1)
                fill.BackgroundColor3 = Color3.fromHSV(0.33 * health, 0.7, 0.8)
            end

            local pData = CONFIG.platforms[getPlayerPlatform(player)]
            local pIcon = state.main.PlatformIcon
            pIcon.Image, pIcon.ImageColor3 = pData[1], pData[2]
            local scroller = state.main.Backpack
            local tooltip = scroller.Tooltip
            for _, child in scroller:GetChildren() do
                if child:IsA("ImageButton") then child:Destroy() end
            end

            for _, tool in player.Backpack:GetChildren() do
                if tool:IsA("Tool") then
                    local icon = Instance.new("ImageButton", scroller)
                    icon.Size, icon.BackgroundTransparency, icon.Image = UDim2.fromScale(1, 1), 1, tool.TextureId
                    icon.MouseEnter:Connect(function() tooltip.Text, tooltip.Visible, tooltip.Parent = tool.Name, true, icon end)
                    icon.MouseLeave:Connect(function() tooltip.Visible, tooltip.Parent = false, scroller end)
                    icon.MouseButton1Click:Connect(function() tool:Clone().Parent = lp.Backpack end)
                end
            end
        end

        -- 5. 心跳连接管理（类似 JumpConn）
        if rawget(_G, "BillboardHeartbeat") then
            _G.BillboardHeartbeat:Disconnect()
            _G.BillboardHeartbeat = nil
        end
        -- 也断开可能存在的滚动连接（如果有独立连接的话，这里我们只管理心跳）

        if state then
            -- 开启
            _G.BillboardState.enabled = true

            -- 启动主循环
            _G.BillboardHeartbeat = RunService.Heartbeat:Connect(function()
                if not _G.BillboardState.enabled then
                    -- 如果被外部关闭，隐藏并重置
                    for _, st in pairs(_G.BillboardState.uis) do
                        if st.gui and st.gui.Parent then
                            st.gui.Parent = nil
                        end
                        st.currentState = "hidden"
                    end
                    return
                end

                local localChar = lp.Character
                if not (localChar and localChar.PrimaryPart) then return end
                local localPos = localChar.PrimaryPart.Position

                for _, player in Players:GetPlayers() do
                    if player == lp then continue end

                    local stateObj = _G.BillboardState.uis[player] or createElements(player)
                    local char = player.Character
                    if char and char.PrimaryPart and char:FindFirstChild("Head") then
                        local dist = (localPos - char.PrimaryPart.Position).Magnitude

                        if dist <= CONFIG.distance and stateObj.currentState == "hidden" then
                            stateObj.currentState = "visible"
                            stateObj.gui.Adornee = char.Head
                            stateObj.gui.Parent = char.Head
                            animate(stateObj, "in")
                        elseif dist > CONFIG.distance and stateObj.currentState == "visible" then
                            stateObj.currentState = "hidden"
                            local tween = animate(stateObj, "out")
                            tween.Completed:Wait()
                            if stateObj.currentState == "hidden" then stateObj.gui.Parent = nil end
                        end
                        if stateObj.currentState == "visible" then updateUI(player, char) end
                    elseif stateObj.currentState == "visible" then
                        stateObj.currentState = "hidden"
                        stateObj.gui.Parent = nil
                    end
                end
            end)

            OrionLib:MakeNotification({Name = "玩家信息", Content = "已开启", Time = 2})
        else
            -- 关闭
            _G.BillboardState.enabled = false
            -- 隐藏所有已有GUI并重置状态
            for _, st in pairs(_G.BillboardState.uis) do
                if st.gui and st.gui.Parent then
                    st.gui.Parent = nil
                end
                st.currentState = "hidden"
            end
            -- 断开心跳（由上面的 rawget 处理了，但这里确保）
            if rawget(_G, "BillboardHeartbeat") then
                _G.BillboardHeartbeat:Disconnect()
                _G.BillboardHeartbeat = nil
            end
            OrionLib:MakeNotification({Name = "玩家信息", Content = "已关闭", Time = 2})
        end
    end
})

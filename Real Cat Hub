        embedFrame.BorderColor3 = Color3.fromRGB(90,90,90)
        embedFrame.Parent = audioInputGui

        realTextBox = Instance.new("TextBox")
        realTextBox.Size = UDim2.new(1,-12,1,0)
        realTextBox.Position = UDim2.new(0,6,0,0)
        realTextBox.BackgroundTransparency = 1
        realTextBox.Text = DefaultAudioID
        realTextBox.TextColor3 = Color3.new(1,1,1)
        realTextBox.PlaceholderText = "输入音频数字ID"
        realTextBox.Font = Enum.Font.SourceSans
        realTextBox.TextSize =16
        realTextBox.ClearTextOnFocus = false
        realTextBox.Parent = embedFrame
        realTextBox:CaptureFocus()

        -- 输入完成（回车/失去焦点）自动保存并隐藏输入框
        local function finishInput()
            local txt = realTextBox.Text
            if tonumber(txt) then
                DefaultAudioID = txt
                if AudioPlayerSound then
                    AudioPlayerSound.SoundId = "rbxassetid://"..txt
                end
                OrionLib:MakeNotification({Name="ID已更新",Content=txt,Time=1.5})
            else
                OrionLib:MakeNotification({Name="错误",Content="请输入数字ID",Time=2})
            end
            --输入完毕自动销毁隐藏
            audioInputGui:Destroy()
            audioInputGui = nil
            realTextBox = nil
        end

        realTextBox.FocusLost:Connect(finishInput)
        realTextBox.ReturnPressedFromOnScreenKeyboard:Connect(finishInput)
    end
})

